# Simulador de envios (simulador_envios.py). Copia este archivo a .env.

# REST de tracking (GET /envios/internal/activos) y su WebSocket de posiciones.
TRACKING_URL=http://127.0.0.1:5900
TRACKING_WS_URL=ws://127.0.0.1:5900/ws?role=gps

# Mismo valor que INTERNAL_API_KEY en apps/services/tracking/.env.
INTERNAL_API_KEY=

# Cada cuantos segundos se consultan los envios activos (ENVIADO / EN_RUTA).
CONSULTA_SEGUNDOS=5
# Cuanto dura cada ruta en la demo (la velocidad se ajusta al largo de la ruta).
DURACION_RUTA_SEGUNDOS=150
# Cada cuantos segundos se manda una posicion.
ENVIO_SEGUNDOS=1
