# --- Servidor ---
PORT=5004

# --- PostgreSQL ---
# Base library_db, usuario library_user. Pon la contraseña real en lugar de "password".
# Verifica el nombre de la base con: psql -U library_user -h localhost -l
# (en instalaciones anteriores del proyecto se llama "library").
DATABASE_URL=postgresql://library_user:password@localhost:5432/library_db

# --- Redis ---
# Pon la contraseña real (requirepass) en lugar de "password". Ver docs/REDIS.md.
REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- JWT (obligatorio) ---
# Mismo valor EXACTO en los 6 microservicios. Si falta, el servicio no arranca.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20

# --- CORS ---
# Origenes de las aplicaciones cliente, separados por comas. Nunca "*".
# Vacio = sin CORS (la app Tk y curl no lo necesitan).
CORS_ALLOWED_ORIGINS=

# --- Llamadas entre microservicios (header X-Internal-Key, timeout 3 s) ---
# Mismo valor en los 6 servicios. Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=
BOOKS_URL=http://127.0.0.1:5001
USERS_URL=http://127.0.0.1:5002
AUTHORS_URL=http://127.0.0.1:5003
PEDIDOS_URL=http://127.0.0.1:5004
PAGOS_URL=http://127.0.0.1:5005

# --- Reserva de stock ---
# Minutos que un pedido PENDIENTE_PAGO conserva su stock reservado antes de pasar a EXPIRADO.
# Para probar la expiracion pon 1 y reinicia el servicio.
RESERVA_MINUTOS=15
