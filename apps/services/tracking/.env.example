# --- Servidor ---
PORT=5900

# --- PostgreSQL ---
# En la VM la base se llama "library" y tracking se conecta con library_user.
# Pon la contraseña real en lugar de "password". tracking solo usa sus tablas
# (envios, envio_posiciones; migración sql/001_envios.sql).
DATABASE_URL=postgresql://library_user:password@localhost:5432/library

# --- Redis ---
# Pon la contraseña real (requirepass) en lugar de "password". Ver docs/REDIS.md.
# Se usa para comprobar la revocación del JWT (jwt:revoked:<jti>).
REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- JWT (obligatorio) ---
# Mismo valor EXACTO que en los demás microservicios. Si falta, el servicio no arranca.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20

# --- CORS ---
# Origenes de las aplicaciones cliente, separados por comas. Nunca "*".
# Vacio = sin CORS (la app de escritorio y curl no lo necesitan).
CORS_ALLOWED_ORIGINS=

# --- Llamadas entre microservicios (header X-Internal-Key, timeout 3 s) ---
# Mismo valor en todos los servicios y en tools/gps_simulator/.env.
INTERNAL_API_KEY=
PEDIDOS_URL=http://127.0.0.1:5004

# --- Envios ---
# Segundos en CONFIRMADO antes de pasar a PREPARANDO, y en PREPARANDO antes de ENVIADO.
SEGUNDOS_CONFIRMADO=15
SEGUNDOS_PREPARANDO=15
# Cada cuantos segundos se reintenta avisar a pedidos (ENVIADO / ENTREGADO).
SINCRONIZACION_SEGUNDOS=5
