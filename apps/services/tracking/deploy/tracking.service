# Unidad systemd del microservicio tracking (gunicorn en 0.0.0.0:5900).
# scripts/levantar_servicios.sh la instala en /etc/systemd/system/tracking.service
# sustituyendo __USER__ y __REPO_DIR__. El .env del servicio lo carga la app.
#
# 1 worker + hilos (gthread): la difusion de eventos a los WebSocket vive en memoria
# del proceso, y cada conexion WebSocket (/ws) ocupa un hilo mientras esta abierta.
# Con --workers > 1 un cliente conectado a un proceso no veria las posiciones que
# llegan a otro, y el hilo de tareas correria duplicado.
[Unit]
Description=Library - microservicio tracking GPS (puerto 5900)
After=network-online.target postgresql.service redis.service valkey.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/apps/services/tracking
ExecStart=__REPO_DIR__/apps/services/tracking/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 50 --timeout 60 --bind 0.0.0.0:5900 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
