# Unidad systemd del microservicio tracking (gunicorn en 0.0.0.0:5900).
# NO la instala scripts/levantar_servicios.sh: se instala a mano (VMComandos.md, seccion 23)
# sustituyendo __USER__ y __REPO_DIR__. tracking no usa .env, PostgreSQL ni Redis.
#
# 1 worker + hilos (gthread): la flota vive en memoria del proceso, y cada conexion
# WebSocket (/ws) ocupa un hilo mientras esta abierta. Con --workers > 1 cada proceso
# tendria su propia flota y los mapas no verian a todos los camiones.
[Unit]
Description=Library - microservicio tracking GPS (puerto 5900)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/apps/services/tracking
ExecStart=__REPO_DIR__/apps/services/tracking/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 50 --timeout 60 --bind 0.0.0.0:5900 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
