# --- Servidor ---
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
# Clave para firmar la cookie de sesión de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacía se genera una aleatoria al arrancar (las sesiones se pierden al reiniciar).
SECRET_KEY=
SESSION_LIFETIME_HOURS=8
# Poner en true solo si el servicio se publica detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# --- JWT (obligatorio) ---
# Secreto HS256 con el que POST /login firma los tokens. Debe tener EXACTAMENTE
# el mismo valor en el .env de los 6 microservicios (login, books, users,
# authors, pedidos, pagos) o responderan 401.
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
# Si falta, el servicio no arranca (JWT_SECRET y SECRET_KEY solo se aceptan
# como respaldo de compatibilidad).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20

# --- Redis (obligatorio: sesiones, refresh tokens y revocacion de JWT) ---
# Pon la contraseña real (requirepass) en lugar de "password". Ver docs/REDIS.md.
REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- CORS ---
# Origenes de las aplicaciones cliente, separados por comas. Nunca "*".
# Vacio = sin CORS (la app Tk y curl no lo necesitan).
CORS_ALLOWED_ORIGINS=

# --- Llamadas entre microservicios (header X-Internal-Key) ---
# Mismo valor en los 6 servicios. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# --- PostgreSQL (misma base 'library' del monolito; rol propio de mínimo privilegio, ver sql/auth_roles.sql) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=auth_user
DB_PASSWORD=auth666

# --- Correo de confirmación (SMTP) ---
# MAIL_MODE=mailpit (por defecto): servidor SMTP local de pruebas, sin TLS ni login.
#   UI web de Mailpit: http://localhost:8025
#     SMTP_HOST=localhost
#     SMTP_PORT=1025
#     SMTP_USER=
#     SMTP_PASSWORD=
# MAIL_MODE=gmail: Gmail real por STARTTLS. SMTP_PASSWORD debe ser una contraseña
# de aplicación de Gmail (https://myaccount.google.com/apppasswords), NUNCA la
# contraseña normal de la cuenta.
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=tu_correo@gmail.com
#     SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_MODE=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Librería <no-reply@libreria.local>

# --- Confirmación de cuenta ---
# URL con la que el usuario alcanza ESTE servicio; se usa para armar el link /confirm?token=...
# (en la VM de GCP: http://IP_PUBLICA:5000)
PUBLIC_BASE_URL=http://localhost:5000
CONFIRM_TOKEN_HOURS=24
