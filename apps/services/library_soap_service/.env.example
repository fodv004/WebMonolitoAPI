FLASK_PORT=5001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=library666

# --- JWT (obligatorio) ---
# Mismo valor EXACTO que JWT_SECRET_KEY en el .env de login y de los demas
# microservicios (si difiere -> 401). Si falta, el servicio no arranca.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# --- Redis (revocacion de JWT y cache del catalogo) ---
# Pon la contraseña real (requirepass) en lugar de "password". Ver docs/REDIS.md.
REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- CORS ---
# Origenes de las aplicaciones cliente, separados por comas. Nunca "*".
# Vacio = sin CORS (la app Tk y curl no lo necesitan).
CORS_ALLOWED_ORIGINS=

# --- Llamadas entre microservicios (header X-Internal-Key); mismo valor en los 6 servicios ---
INTERNAL_API_KEY=

# --- WS-Security del endpoint /soap (operacion ObtenerEstadisticasPorModelo) ---
WS_SECURITY_USER=
WS_SECURITY_PASSWORD_HASH=
