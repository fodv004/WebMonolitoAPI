<%- include('../partials/head') %><div class="title"><h1>Catálogo de libros</h1><% if(user?.es_admin){ %><a class="button" href="<%= base %>/libros/nuevo">+ Nuevo libro</a><% } %></div><form class="search" method="get" action="<%= base %>/libros"><input type="text" name="q" placeholder="Buscar por ISBN o título…" value="<%= q %>"><button>Buscar</button><% if(q){ %><a class="button" href="<%= base %>/libros">Limpiar</a><% } %></form><div class="grid"><% items.forEach(book=>{ %><article class="book"><div class="book-cover"><% if(book.portada){ %><img src="<%= book.portada.startsWith('http')?book.portada:base+book.portada %>" alt="Portada de <%= book.titulo %>" loading="lazy"><% } else { %><div class="cover-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg></div><% } %></div><div class="book-info"><h2><a href="<%= base %>/libros/<%= book.isbn %>"><%= book.titulo %></a></h2><p class="book-authors"><%= book.autores %></p><div class="book-meta"><span class="badge badge-format"><%= book.formato %></span><span class="badge <%= book.stock>0?'badge-stock':'badge-out' %>"><%= book.stock>0?book.stock+' en stock':'Agotado' %></span></div><p class="book-price">$<%= book.precio %></p></div></article><% }) %><% if(!items.length){ %><p><%= q?'No se encontraron libros para "'+q+'".':'Aún no hay libros registrados.' %></p><% } %></div><%- include('../partials/foot') %>
