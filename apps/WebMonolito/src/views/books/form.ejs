<%- include('../partials/head') %><h1><%= book?'Editar':'Nuevo' %> libro</h1><form class="card form" method="post" action="<%= base %>/libros<%= book?'/'+book.isbn:'' %>" <%= book?'data-confirm="¿Guardar los cambios de este libro?"':'' %>><label>ISBN-13<input name="isbn" pattern="[0-9Xx-]{10,17}" value="<%= book?.isbn||'' %>" required></label><label>Título<input name="titulo" value="<%= book?.titulo||'' %>" required></label><label>Año de publicación<input type="number" min="1" name="anio_publicacion" value="<%= book?.anio_publicacion||'' %>" required></label><label>Precio<input type="number" min="0" step="0.01" name="precio" value="<%= book?.precio||'' %>" required></label><label>Stock<input type="number" min="0" name="stock" value="<%= book?.stock||0 %>" required></label><label>Formato<select name="id_formato" required><option value="">Selecciona…</option><% formatos.forEach(x=>{ %><option value="<%= x.id_formato %>" <%= book?.id_formato===x.id_formato?'selected':'' %>><%= x.nombre %></option><% }) %></select></label><fieldset><legend>Autores</legend><% autores.forEach(x=>{ %><label class="check"><input type="checkbox" name="autores" value="<%= x.id_autor %>" <%= book?.autores.some(a=>a.id_autor===x.id_autor)?'checked':'' %>><%= x.nombre %></label><% }) %></fieldset><fieldset><legend>Géneros</legend><% generos.forEach(x=>{ %><label class="check"><input type="checkbox" name="generos" value="<%= x.id_genero %>" <%= book?.generos.some(g=>g.id_genero===x.id_genero)?'checked':'' %>><%= x.nombre %></label><% }) %></fieldset><button>Guardar libro y relaciones</button></form><%- include('../partials/foot') %>
