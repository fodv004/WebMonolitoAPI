<%- include('../partials/head') %><div class="book-hero"><div class="book-cover"><% if(book.imagenes[0]){ %><img src="<%= book.imagenes[0].url.startsWith('http')?book.imagenes[0].url:base+book.imagenes[0].url %>" alt="Portada de <%= book.titulo %>"><% } else { %><div class="cover-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg></div><% } %></div><div class="book-hero-info"><h1><%= book.titulo %></h1><div class="meta-row"><span class="badge badge-format">ISBN <%= book.isbn %></span><span class="badge badge-format"><%= book.anio_publicacion %></span><span class="book-price">$<%= book.precio %></span><span class="badge <%= book.stock>0?'badge-stock':'badge-out' %>"><%= book.stock>0?book.stock+' en stock':'Agotado' %></span></div><% if(user?.es_admin){ %><div class="book-hero-actions"><a class="button" href="<%= base %>/libros/<%= book.isbn %>/editar">Editar libro</a></div><% } %></div></div><section class="card"><h2>Autores</h2><p><%= book.autores.map(x=>x.nombre).join(', ') || 'Sin autores' %></p><h2>Géneros</h2><p><%= book.generos.map(x=>x.nombre).join(', ') || 'Sin géneros' %></p></section><section class="card"><h2>Conceptos y definiciones</h2><% book.conceptos.forEach(x=>{ %><article><strong><%= x.nombre %></strong><p><%= x.definicion %></p><% if(user?.es_admin){ %><form method="post" action="<%= base %>/libros/<%= book.isbn %>/conceptos/<%= x.id_concepto %>/eliminar" data-confirm="¿Quitar el concepto &quot;<%= x.nombre %>&quot; de este libro?"><button class="danger">Quitar</button></form><% } %></article><% }) %><% if(user?.es_admin){ %><form class="form" method="post" action="<%= base %>/libros/<%= book.isbn %>/conceptos"><label>Concepto<select name="id_concepto"><% conceptos.forEach(x=>{ %><option value="<%= x.id_concepto %>"><%= x.nombre %></option><% }) %></select></label><label>Definición<textarea name="definicion" required></textarea></label><button>Guardar concepto</button></form><% } %></section><section class="card"><h2>Imágenes</h2><div class="gallery"><% book.imagenes.forEach(x=>{ %><figure><img src="<%= x.url.startsWith('http')?x.url:base+x.url %>" alt="Imagen del libro"><figcaption><%= x.es_principal?'Principal':'' %> <% if(user?.es_admin){ %><form method="post" action="<%= base %>/libros/<%= book.isbn %>/imagenes/<%= x.id_imagen %>/eliminar" data-confirm="¿Eliminar esta imagen del libro?"><button class="danger">Eliminar</button></form><% } %></figcaption></figure><% }) %></div><% if(user?.es_admin){ %><form class="form" method="post" enctype="multipart/form-data" action="<%= base %>/libros/<%= book.isbn %>/imagenes"><label>Archivo de imagen (JPG, PNG o WebP, máx. 5MB)<input type="file" name="imagen" accept="image/jpeg,image/png,image/webp"></label><label>o URL externa<input type="url" name="url"></label><label>Orden<input type="number" name="orden" value="0"></label><label class="check"><input type="checkbox" name="es_principal"> Marcar como principal</label><button>Agregar imagen</button></form><form method="post" action="<%= base %>/libros/<%= book.isbn %>/eliminar" data-confirm="¿Eliminar el libro &quot;<%= book.titulo %>&quot;? Esta acción no se puede deshacer."><button class="danger">Eliminar libro</button></form><% } %></section><%- include('../partials/foot') %>
