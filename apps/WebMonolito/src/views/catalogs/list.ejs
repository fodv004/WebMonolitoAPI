<%- include('../partials/head') %><div class="title"><h1><%= type[0].toUpperCase()+type.slice(1) %></h1><a class="button" href="<%= base %>/catalogos/<%= type %>/nuevo">+ Nuevo</a></div><nav class="tabs"><a href="<%= base %>/catalogos/formatos">Formatos</a><a href="<%= base %>/catalogos/generos">Géneros</a><a href="<%= base %>/catalogos/autores">Autores</a><a href="<%= base %>/catalogos/conceptos">Conceptos</a></nav><table><thead><tr><th>ID</th><% fields.forEach(f=>{ %><th><%= f %></th><% }) %><th>Acciones</th></tr></thead><tbody><% items.forEach(item=>{ const id=Object.values(item)[0]; %><tr><td><%= id %></td><% fields.forEach(f=>{ %><td><%= item[f] || '—' %></td><% }) %><td><a href="<%= base %>/catalogos/<%= type %>/<%= id %>/editar">Editar</a><form class="inline" method="post" action="<%= base %>/catalogos/<%= type %>/<%= id %>/eliminar" data-confirm="¿Eliminar este registro? Esta acción no se puede deshacer."><button class="danger">Eliminar</button></form></td></tr><% }) %></tbody></table><%- include('../partials/foot') %>
