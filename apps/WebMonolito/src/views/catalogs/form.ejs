<%- include('../partials/head') %><h1><%= item?'Editar':'Nuevo' %> <%= type %></h1><form class="card form" method="post" action="<%= base %>/catalogos/<%= type %><%= item?'/'+Object.values(item)[0]:'' %>" <%= item?'data-confirm="¿Guardar los cambios de este registro?"':'' %>><% fields.forEach(f=>{ %><label><%= f[0].toUpperCase()+f.slice(1) %><input name="<%= f %>" value="<%= item?.[f] || '' %>" <%= f==='nombre'?'required':'' %>></label><% }) %><button>Guardar</button></form><%- include('../partials/foot') %>
