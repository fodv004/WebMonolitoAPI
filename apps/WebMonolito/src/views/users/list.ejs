<%- include('../partials/head') %><div class="title"><h1>Usuarios</h1><a class="button" href="<%= base %>/usuarios/nuevo">+ Nuevo usuario</a></div><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th><th>Acciones</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.nombre %></td><td><%= item.correo %></td><td><span class="badge <%= item.es_admin?'badge-role-admin':'badge-role-user' %>"><%= item.es_admin?'Administrador':'Usuario' %></span></td><td><span class="badge <%= item.activo?'badge-active':'badge-inactive' %>"><%= item.activo?'Activo':'Inactivo' %></span></td><td><a href="<%= base %>/usuarios/<%= item.id_usuario %>/editar">Editar</a><form class="inline" method="post" action="<%= base %>/usuarios/<%= item.id_usuario %>/eliminar" data-confirm="¿Eliminar al usuario &quot;<%= item.nombre %>&quot;? Esta acción no se puede deshacer."><button class="danger">Eliminar</button></form></td></tr><% }) %></tbody></table><%- include('../partials/foot') %>
