<%- include('../partials/head') %><h1><%= item?'Editar':'Nuevo' %> usuario</h1><form class="card form" method="post" action="<%= base %>/usuarios<%= item?'/'+item.id_usuario:'' %>" <%= item?'data-confirm="¿Guardar los cambios de este usuario?"':'' %>><label>Nombre<input name="nombre" maxlength="150" value="<%= item?.nombre || '' %>" required></label><label>Apellido paterno<input name="apellido_paterno" maxlength="100" value="<%= item?.apellido_paterno || '' %>" required></label><label>Apellido materno <small>(opcional en cuentas antiguas)</small><input name="apellido_materno" maxlength="100" value="<%= item?.apellido_materno || '' %>" <%= item?'':'required' %>></label><label>Correo<input type="email" name="correo" value="<%= item?.correo || '' %>" required></label><label>Contraseña <small><%= item?'(deja vacío para no cambiarla)':'' %></small><input type="password" name="password" <%= item?'':'required minlength=8' %>></label><label class="check"><input type="checkbox" name="es_admin" <%= item?.es_admin?'checked':'' %>> Administrador (máximo uno)</label><label class="check"><input type="checkbox" name="activo" <%= !item || item.activo?'checked':'' %>> Cuenta activa</label><label>Estado de la cuenta<select name="estado_cuenta"><option value="confirmado" <%= !item || item.estado_cuenta==='confirmado'?'selected':'' %>>Confirmado</option><option value="pendiente" <%= item && item.estado_cuenta==='pendiente'?'selected':'' %>>Pendiente de confirmar</option></select></label><button>Guardar</button></form><%- include('../partials/foot') %>
